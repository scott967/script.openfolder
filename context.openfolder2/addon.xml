<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="context.openfolder2" name="Open item folder" version="2.1.1" provider-name="scott967">
	<requires>
		<import addon="xbmc.python" version="3.0.0" />
	</requires>
	<extension point="kodi.context.item">
		<menu id="kodi.core.main">
			<item library="python/context.py">
				<label>32100</label>
					<visible>String.IsEqual(ListItem.DBType, musicvideo) | String.IsEqual(ListItem.DBType, movie) | String.IsEqual(ListItem.DBType, song) | String.IsEqual(ListItem.DBType, tvshow) | String.IsEqual(ListItem.DBType, episode)</visible>
			</item>
		</menu>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Opens local folder containing item.</summary>
		<description lang="en_GB">This add-on can quickly open the folder containing a library item.</description>
		<news>v2.1.1 (2025-01-16)
</news>
		<platform>all</platform>
		<source>https://github.com/scott967/script.openfolder2</source>
		<forum></forum>
		<license>MIT</license>
		<assets>
			<icon>icon.png</icon>
		</assets>
	</extension>
</addon>
